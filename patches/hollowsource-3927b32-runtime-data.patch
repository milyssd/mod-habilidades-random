+bool ObjectMgr::RegisterRuntimePlayerInfo(uint32 race, uint32 classId, PlayerInfo const& source,
+    std::vector<PlayerLevelInfo> const& levels)
+{
+    uint32 maxLevel = sWorld->getIntConfig(CONFIG_MAX_PLAYER_LEVEL);
+    if (!maxLevel || !race || !classId || race >= _playerInfo.size() || classId >= _playerInfo[race].size() ||
+        _playerInfo[race][classId] || !source.displayId_m || !source.displayId_f || levels.size() != maxLevel)
+        return false;
+
+    auto info = std::make_unique<PlayerInfo>(source);
+    info->levelInfo = nullptr;
+    auto levelData = std::make_unique<PlayerLevelInfo[]>(maxLevel);
+    std::copy(levels.begin(), levels.end(), levelData.get());
+    // Match ObjectMgr::~ObjectMgr ownership: one PlayerInfo and one independent levelInfo array.
+    info->levelInfo = levelData.release();
+    _playerInfo[race][classId] = info.release();
+    return true;
+}
+
+bool ObjectMgr::RegisterRuntimeCreatureTemplate(CreatureTemplate const& source)
+{
+    // Bound allocations, reject collisions and validate every model before registering anything.
+    if (!source.Entry || source.Entry > 1000000 || _creatureTemplateStore.count(source.Entry) || source.Models.empty())
+        return false;
+    for (CreatureModel const& model : source.Models)
+        if (!sCreatureDisplayInfoStore.LookupEntry(model.CreatureDisplayID) ||
+            !GetCreatureModelInfo(model.CreatureDisplayID))
+            return false;
+
+    // Allocate the fast index first; unordered_map rehash keeps element pointers valid.
+    if (_creatureTemplateStoreFast.size() <= source.Entry)
+        _creatureTemplateStoreFast.resize(source.Entry + 1, nullptr);
+    auto [itr, inserted] = _creatureTemplateStore.emplace(source.Entry, source);
+    if (!inserted)
+        return false;
+    _creatureTemplateStoreFast[source.Entry] = &itr->second;
+    itr->second.InitializeQueryData();
+    return true;
+}
