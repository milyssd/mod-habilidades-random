<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

  <!-- El margen transparente de la carta no debe recibir clics. -->
<Button name="SpellChoiceButtonTemplate" virtual="true" enableMouse="true">
  <Size><AbsDimension x="256" y="256"/></Size>
  <HitRectInsets left="38" right="38" top="28" bottom="28"/>

  <Layers>

    <!-- Fondo -->
    <Layer level="BACKGROUND">
      <Texture name="$parentBackground" file="Interface\AddOns\HabilidadesRandom\Textures\card.tga">
        <Anchors>
          <Anchor point="TOPLEFT"/>
          <Anchor point="BOTTOMRIGHT"/>
        </Anchors>
      </Texture>
    </Layer>

    <!-- Nombre del poder -->
    <Layer level="ARTWORK">
      <FontString name="$parentName" inherits="GameFontNormal" justifyH="CENTER">
        <Size x="168" y="32"/>
        <Anchors>
          <Anchor point="TOP" x="0" y="-38"/>
        </Anchors>
      </FontString>
    </Layer>

    <!-- Icono -->
    <Layer level="ARTWORK">
      <Texture name="$parentIcon" file="Interface\Icons\INV_Misc_QuestionMark" setAllPoints="false">
        <Size x="96" y="96"/>
        <Anchors>
          <Anchor point="TOP" relativeTo="$parentName" relativePoint="BOTTOM" x="0" y="-8"/>
        </Anchors>
      </Texture>
    </Layer>

  <Layer level="OVERLAY">
    <Texture name="$parentRarity" file="Interface\AddOns\HabilidadesRandom\Textures\COMM.tga">
      <Size x="24" y="24"/>
      <Anchors>
        <Anchor point="TOP" relativeTo="$parentIcon" relativePoint="BOTTOM" x="0" y="8"/>
      </Anchors>
    </Texture>
  </Layer>

    <Layer level="OVERLAY">
      <FontString name="$parentLevelReq" inherits="GameFontNormalSmall">
        <Size x="168" y="28"/>
        <Anchors>
          <Anchor point="BOTTOM" x="0" y="34"/>
        </Anchors>
        <Color r="1.0" g="0.82" b="0.0"/>
      </FontString>
    </Layer>
    <!-- Borde de selección -->
    <Layer level="OVERLAY">
      <Texture name="$parentSelectionBorder" file="Interface\Buttons\UI-ActionButton-Border" hidden="true">
        <Size><AbsDimension x="160" y="180"/></Size>
        <Anchors>
          <Anchor point="CENTER"/>
        </Anchors>
      </Texture>
    </Layer>

  </Layers>

</Button>
  <!-- Ventana de elecciones -->
<Frame name="SpellChoiceFrame" parent="UIParent" hidden="true" movable="true" frameStrata="FULLSCREEN_DIALOG" enableMouse="true">
    <Size><AbsDimension x="650" y="300"/></Size>
    <Anchors>
      <Anchor point="CENTER"/>
    </Anchors>



    <BackdropBorderColor r="1.0" g="0.82" b="0.0"/>

    <Layers>
      <Layer level="ARTWORK">
        <FontString name="SpellChoiceTitle" inherits="GameFontNormalLarge">
          <Anchors>
            <Anchor point="TOP" x="0" y="-20"/>
          </Anchors>
          <Color r="1.0" g="0.85" b="0.1"/>
          <ShadowOffset>
            <AbsDimension x="1" y="-1"/>
          </ShadowOffset>
          <ShadowColor r="0" g="0" b="0" a="1"/>
        </FontString>
      </Layer>
    </Layers>

    <!-- Cartas disponibles -->
    <Frames>
      <Button name="SpellChoiceButton1" inherits="SpellChoiceButtonTemplate" enableMouse="true">
        <Anchors>
          <Anchor point="CENTER" x="-210" y="0"/>
        </Anchors>
      </Button>

      <Button name="SpellChoiceButton2" inherits="SpellChoiceButtonTemplate" enableMouse="true">
        <Anchors>
          <Anchor point="CENTER" x="0" y="0"/>
        </Anchors>
      </Button>

      <Button name="SpellChoiceButton3" inherits="SpellChoiceButtonTemplate" enableMouse="true">
        <Anchors>
          <Anchor point="CENTER" x="210" y="0"/>
        </Anchors>
      </Button>

      <!-- Cambiar la oferta -->
      <Button name="SpellChoiceRerollButton" inherits="UIPanelButtonTemplate" text="Cambiar">
        <Size><AbsDimension x="130" y="24"/></Size>
        <Anchors>
          <Anchor point="BOTTOM" relativeTo="SpellChoiceTitle" relativePoint="TOP" x="0" y="10"/>
        </Anchors>
      </Button>
      <!-- Ocultar o volver a abrir -->
      <Button name="SpellChoiceDismissButton" inherits="UIPanelButtonTemplate" text="Ocultar">
        <Size><AbsDimension x="180" y="24"/></Size>
        <Anchors>
          <Anchor point="CENTER" relativeTo="SpellChoiceTitle" relativePoint="TOP" x="0" y="-290"/>
        </Anchors>
      </Button>
    </Frames>
  </Frame>
</Ui>
