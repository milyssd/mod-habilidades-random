###############################################################################
#                        HABILIDADES ALEATORIAS                               #
#                     Desafío de leveo hasta nivel 80                          #
###############################################################################
#
# El jugador acepta el desafío en un NPC y pasa a druida temporalmente,
# conservando su raza. Recibe poderes aleatorios y no puede asignar talentos.
# Al nivel 80 recupera su clase, poderes y talentos originales.
#
# La base del módulo se crea al arrancar worldserver. No hay SQL que importar.
# Por defecto se usan las credenciales del core; no hace falta otra contraseña.
#
###############################################################################

[worldserver]

#==============================================================================
# 1. EVENTO
#==============================================================================

# 1 = activar el evento. Al arrancar con 0 no se abre su base ni se crean NPC.
# Si se cambia a 0 con el evento ya funcionando, se cierran las inscripciones
# y se restauran participantes cuando sea seguro, usando la conexión existente.
# Para volver a activar tras un arranque con 0, reinicia worldserver.
HabilidadesRandom.Enable = 1

# Bloquear el aprendizaje normal de hechizos de clase durante el desafío.
# No afecta a profesiones. Los talentos siempre permanecen bloqueados
# hasta completar la restauración al nivel 80.
HabilidadesRandom.BlockTrainerSpells = 1

#==============================================================================
# 2. NPC DEL DESAFÍO
#==============================================================================

# Entrada de la plantilla creada en memoria. El ID debe estar libre.
# Como GM: .hr npc para colocarlo; .hr removenpc para retirar el seleccionado.
# Su posición se guarda en la base del módulo.
HabilidadesRandom.NpcEntry = 900100

#==============================================================================
# 3. ELECCIONES DE PODERES
#==============================================================================

# Elecciones disponibles al aceptar el desafío.
HabilidadesRandom.InitialDrafts = 1

# Elecciones adicionales por cada nivel nuevo alcanzado.
HabilidadesRandom.DraftsPerLevel = 1

# Tamaño del conjunto de candidatos utilizado para preparar las cartas.
HabilidadesRandom.PoolAmount = 45

#==============================================================================
# 4. CAMBIOS DE CARTAS Y BLOQUEOS
#==============================================================================

# Cambios de oferta disponibles al entrar. Cada cambio sustituye las tres cartas.
HabilidadesRandom.InitialRerolls = 5

# Cambios adicionales por cada nivel nuevo alcanzado.
HabilidadesRandom.RerollsPerLevel = 2

# Poderes que se pueden bloquear durante el desafío.
# Un bloqueo sustituye esa carta y evita que vuelva a aparecer.
HabilidadesRandom.InitialBans = 5

#==============================================================================
# 5. RAREZA DE LAS CARTAS
#==============================================================================

# Habilitar la categoría experimental (Broken). Requiere validar sus poderes
# en el servidor antes de abrir el evento a los jugadores.
HabilidadesRandom.IncludeRarity5 = 0

# Pesos relativos de las categorías. No tienen que sumar 1.
# 0 = excluir esa categoría de las ofertas nuevas.
# La categoría experimental solo participa si IncludeRarity5 = 1.
HabilidadesRandom.Distribution.Common = 0.50
HabilidadesRandom.Distribution.Uncommon = 0.27
HabilidadesRandom.Distribution.Rare = 0.14
HabilidadesRandom.Distribution.Epic = 0.06
HabilidadesRandom.Distribution.Legendary = 0.03
HabilidadesRandom.Distribution.Broken = 0.01

#==============================================================================
# 6. BASE DE DATOS PROPIA
#==============================================================================

# Nombre de la base que contendrá únicamente las tablas de este módulo.
# Si tienes varios reinos en el mismo MySQL, usa un nombre distinto por reino.
HabilidadesRandom.DatabaseName = "mod_habilidades_random"

# Conexión opcional para instalaciones avanzadas. Normalmente debe quedar vacía:
# así se reutilizan las credenciales ya configuradas para personajes en el core.
# Esa cuenta MySQL necesita permiso para crear y administrar la base del módulo.
# Formato opcional: host;puerto_o_socket;usuario;contraseña;base_privada[;ssl]
# Si se completa, la base incluida en esta cadena tiene prioridad sobre DatabaseName.
HabilidadesRandom.DatabaseInfo = ""
